# ============================================================
#  JARVIS â€” configuration
#  Copy this file to .env and fill in the values you need.
#  NOTHING here is a real secret; .env is git-ignored.
# ============================================================

# ---------- core ----------
# Single-user bearer token. The API and the WebSocket require it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_AUTH_TOKEN=change-me-please-use-a-long-random-string
LOG_LEVEL=INFO
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ---------- LLM provider ----------
# openai (default) | anthropic | openrouter (free-tier models)
LLM_PROVIDER=openai

# --- OpenAI (default provider) ---
OPENAI_API_KEY=
# Models below were chosen by probing this account's model list for
# function-tool + streaming support (see README -> "LLM provider setup").
OPENAI_MODEL=gpt-6.1-terra
# Cheap model for background memory extraction
OPENAI_MODEL_FAST=gpt-5.4-mini
# Optional: OpenAI-compatible gateway / proxy (e.g. https://host/v1)
OPENAI_BASE_URL=
# gpt-6.x refuses function tools on /chat/completions unless this is "none".
# Leave empty to omit the parameter entirely.
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_TOKENS=1500
OPENAI_TIMEOUT=120

# --- Anthropic (only used when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_UTILITY_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=1500
ANTHROPIC_TIMEOUT=120

# --- OpenRouter (only used when LLM_PROVIDER=openrouter) ---
# An OpenAI-compatible gateway with genuinely free models, for when the OpenAI
# quota runs out. Keys: https://openrouter.ai/settings/keys
# Free models are rate limited; JARVIS backs off on 429 and reports 402 as-is.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview
# Empty -> same as OPENROUTER_MODEL
OPENROUTER_MODEL_FAST=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_TIMEOUT=120
# Optional attribution headers (OpenRouter app rankings); empty = not sent
OPENROUTER_REFERER=
OPENROUTER_TITLE=JARVIS

# Agent loop hard stops
MAX_TOOL_ITERATIONS=6
HISTORY_LIMIT=30
# How long the UI has to approve a destructive tool call (seconds)
CONFIRMATION_TIMEOUT=180

# ---------- storage ----------
# Leave DATABASE_URL empty to use SQLite at <data_dir>/jarvis.db
DATABASE_URL=
DATA_DIR=data
# File tools are sandboxed to this folder
WORKSPACE_DIR=workspace
# Editable persona / system prompt
PERSONA_PATH=persona.md

# ---------- memory ----------
MEMORY_TOP_K=6
MEMORY_MIN_SCORE=0.12
MEMORY_EXTRACTION_ENABLED=true

# ---------- web search ----------
# duckduckgo (free, no key) | tavily | serpapi
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=5

# ---------- speech ----------
# browser  = Web Speech API in the browser (free, zero setup)
# whisper  = POST audio to OpenAI Whisper (reuses OPENAI_API_KEY)
STT_PROVIDER=browser
# browser    = SpeechSynthesis in the browser (free, zero setup)
# openai     = OpenAI audio endpoint (reuses OPENAI_API_KEY)
# elevenlabs = server-side TTS (needs ELEVENLABS_API_KEY)
TTS_PROVIDER=browser
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---------- safe command runner ----------
# Prefix whitelist (comma separated). A command may only run if the whole
# command string starts with one of these prefixes.
ALLOWED_COMMANDS=ping,ipconfig,whoami,hostname,git status,git log,git diff,python --version,node --version,echo
COMMAND_TIMEOUT=20

# ---------- approval policy ----------
# Only these tools pause for an explicit OK in the UI. Everything not listed
# runs straight away (reads, notes, tasks, reminders, opening apps and URLsâ€¦).
#   *  = ask for every tool       (empty = use each tool's own default)
CONFIRM_TOOLS=run_command

# ---------- Google (Calendar + Gmail + Contacts) ----------
# Off by default. See README "Google integrations" for the 5 minute setup.
# Scopes: calendar.readonly, gmail.readonly, gmail.compose (drafts only),
#         contacts.readonly, contacts.other.readonly — all read-only.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=UTC
# also search the auto-collected "other contacts" (people you have emailed)
GOOGLE_CONTACTS_INCLUDE_OTHER=true

# ---------- WhatsApp (send messages) ----------
# auto  = Cloud API when the token + phone id below are set, otherwise the
#         wa.me hand-off (WhatsApp opens with your text pre-filled; you press send)
# cloud = always the Cloud API (real sends, see README â†’ WhatsApp messages)
# link  = always the wa.me hand-off (no credentials needed)
WHATSAPP_ENABLED=true
WHATSAPP_MODE=auto
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v27.0
# name=+countrynumber pairs, semicolon separated:
# WHATSAPP_CONTACTS=mom=+919876543210;ravi=+447700900123
WHATSAPP_CONTACTS=
# prepended to numbers spoken without a country code, e.g. 91 for India
WHATSAPP_COUNTRY_CODE=
# local mirror of Google Contacts, used to turn a name into a number offline
WHATSAPP_CONTACTS_CACHE=data/contacts_cache.json
# runtime-editable aliases (name -> number); whatsapp_save_contact writes this and
# it takes effect immediately, unlike WHATSAPP_CONTACTS which needs a restart
WHATSAPP_ALIASES=data/whatsapp_aliases.json
# auto-send: after opening whatsapp://send, wait, then press Enter in the chat
# window. The host bridge only presses it when WhatsApp is actually in the
# foreground, so a stray Enter can never land in another app.
WHATSAPP_AUTOSEND=false
WHATSAPP_AUTOSEND_DELAY_MS=2000

# ---------- desktop apps (host bridge) ----------
# The backend runs in Docker and cannot touch the Windows desktop, so open/close
# requests are queued in workspace/.appbridge and executed by host/app-bridge.ps1
# on the host. Start it once with host\start-bridge.cmd and keep it running.
APPS_BRIDGE_ENABLED=true
# seconds to wait for the host to answer a request
APPS_BRIDGE_TIMEOUT=12
# ask for approval before launching (closing always asks)
APPS_REQUIRE_CONFIRMATION=false
# alias=launch-target[|process-name] ; separated by semicolons.
# The process name is only needed when it differs from the executable name
# (UWP apps, shims like code.cmd, names with spaces).
# Targets may use %ENVIRONMENT_VARIABLES% and forward slashes, so one line
# works on any machine (the watcher expands and normalises them).
# Microsoft Store (MSIX) apps launch through their shell target:
#   whatsapp=shell:AppsFolder/5319275A.WhatsAppDesktop_cv1g1gvanyjgm!App|WhatsApp.Root
APPS_ALLOWLIST=notepad=notepad.exe;calculator=calc.exe|CalculatorApp;paint=mspaint.exe;explorer=explorer.exe;chrome=chrome.exe;edge=msedge.exe;firefox=firefox.exe;code=code.cmd|Code;antigravity=%LOCALAPPDATA%/Programs/Antigravity IDE/Antigravity IDE.exe|Antigravity IDE;spotify=spotify.exe;terminal=wt.exe;settings=ms-settings:
# never closable, even if allowlisted above (shell, session, services)
APPS_DENYLIST=explorer,winlogon,csrss,lsass,svchost,services,dwm,wininit,smss
# URI schemes the bridge may hand to the shell (WhatsApp deep links, Settings)
APPS_URI_SCHEMES=whatsapp,ms-settings
# how long to wait for a polite close before terminating the app
APPS_CLOSE_GRACE_MS=2500
# set false to only report apps that ignore the close request
APPS_FORCE_AFTER_GRACE=true

# ---------- housekeeping ----------
REMINDER_POLL_SECONDS=5
